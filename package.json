{
  "name": "nexo",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Entre Paréntesis multilingual nested-clue game backed by Supabase.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pages",
    "build:standalone": "vite build",
    "build:pages": "tsx scripts/build-pages.ts",
    "preview": "vite preview",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "diagnostics:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:pages": "npm run build:pages && tsx --test tests/pages/*.test.ts",
    "test:e2e": "npm run build:pages && playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:pages && npm run test:e2e",
    "deploy:prepare": "sh scripts/prepare-deploy.sh",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@effect/tsgo": "0.39.0",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "^29.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.29",
    "@deck.gl/geo-layers": "^9.0.29",
    "@deck.gl/layers": "^9.0.29",
    "@deck.gl/react": "^9.0.29",
    "@supabase/supabase-js": "^2.116.0",
    "deck.gl": "^9.0.29",
    "effect": "4.0.0-rc.112",
    "mapbox-gl": "^3.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
