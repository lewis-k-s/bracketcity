{
  "name": "nexo",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "The Nexo multilingual nested-clue game and WordPress plugin.",
  "scripts": {
    "dev": "vite",
    "dev:studio-assets": "vite --config vite.wordpress.config.ts",
    "studio:dev": "sh scripts/studio-dev.sh dev",
    "studio:link": "sh scripts/studio-dev.sh link",
    "studio:start": "sh scripts/studio-dev.sh start",
    "studio:status": "sh scripts/studio-dev.sh status",
    "studio:restore-plugin": "sh scripts/studio-dev.sh restore-plugin",
    "build": "npm run build:pages",
    "build:standalone": "vite build",
    "build:pages": "tsx scripts/build-pages.ts",
    "preview": "vite preview",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "diagnostics:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:php": "tsx scripts/test-php.ts",
    "test:wordpress": "sh tests/php/run-wordpress-integration.sh",
    "test:pages": "npm run build:pages && tsx --test tests/pages/*.test.ts",
    "test:package": "tsx --test tests/package/*.test.ts",
    "test:e2e": "npm run build:pages && playwright test",
    "test:all": "npm run typecheck && npm run test:unit && npm run test:php && npm run test:pages && npm run test:package && npm run test:wordpress && npm run test:e2e",
    "package:plugin": "npm run typecheck && tsx scripts/package-plugin.ts && tsx scripts/verify-wordpress-package.ts",
    "deploy:prepare": "sh scripts/prepare-deploy.sh",
    "package:verify": "tsx scripts/package-plugin.ts --verify-only --skip-checks",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@effect/tsgo": "0.39.0",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "jsdom": "^29.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.29",
    "@deck.gl/geo-layers": "^9.0.29",
    "@deck.gl/layers": "^9.0.29",
    "@deck.gl/react": "^9.0.29",
    "deck.gl": "^9.0.29",
    "effect": "4.0.0-rc.112",
    "mapbox-gl": "^3.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
